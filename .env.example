# ==============================================================================
# SMAUMU (SMAN UntukMu) - Web In Action (WIA) MIA 2026
# Environment Variables Configuration Template
# ==============================================================================

# Server & Static Host Environment
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_NAME="SMAUMU - SMAN UntukMu"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPETITION="Web In Action (WIA) MIA 2026"
NEXT_PUBLIC_THEME="Designing Digital Futures – Powering Public Transparency"

# GitHub Pages Base Path (Optional: set to /repo-name if hosted at username.github.io/repo-name)
NEXT_PUBLIC_BASE_PATH=""

# Supabase Cloud Backend Configuration
# Dapatkan URL dan anon key dari: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Database Configuration (PostgreSQL Relational Schema)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smaumu_db?schema=public"
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="your_secure_password_here"
DB_NAME="smaumu_db"

# Security & Cryptographic Keys (Public Service Tracking & Audit Chain)
NEXTAUTH_SECRET="smaumu-super-secret-salt-wia2026-integrity-key-778899"
NEXTAUTH_URL="http://localhost:3000"
TICKET_AES_SECRET_KEY="aes-256-gcm-smaumu-wia2026-ticket-key"
AUDIT_MERKLE_SALT="sha256-merkle-audit-chain-immutable-salt"

# Geolocation & GIS Engine API
NEXT_PUBLIC_DEFAULT_LAT=-6.2088
NEXT_PUBLIC_DEFAULT_LNG=106.8456
NEXT_PUBLIC_GIS_TOLERANCE_METERS=150
NEXT_PUBLIC_GEO_ANOMALY_THRESHOLD_METERS=500
# Optional: Google Maps Platform API Key (Peta sudah berjalan out-of-the-box dengan high-res tiles)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Civic Whistleblower Protection
WHISTLEBLOWER_SALT_ROUNDS=12
ANONYMOUS_TOKEN_PREFIX="WHISTLE-WIA2026-"
